{
  "name": "ghat-ishara-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run map:preflight:source && npm run typecheck && vite build && npm run map:preflight",
    "map:preflight:source": "node scripts/map-hosting/preflight.mjs --source-only",
    "map:preflight": "node scripts/map-hosting/preflight.mjs",
    "verify:map-hosted": "node scripts/map-hosting/verify-hosted.mjs",
    "test:map-hosting": "node scripts/map-hosting/test-hosting.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify:browser": "node scripts/verify.mjs",
    "test:permissions": "node scripts/verify-permissions.mjs",
    "check:edge": "deno check --node-modules-dir=manual supabase/functions/invite-official/index.ts",
    "test:portal-browser": "node scripts/verify-portal.mjs",
    "test:edge": "deno test --node-modules-dir=manual --deny-net --deny-env supabase/functions/invite-official/handler.test.ts",
    "test:public-env": "node scripts/verify-public-env.mjs",
    "test:bootstrap": "node scripts/verify-bootstrap.mjs",
    "test:local-recovery": "node scripts/verify-local-recovery.mjs",
    "test:persistence": "node scripts/verify-persistence.mjs",
    "test:persistence-browser": "node scripts/verify-persistence-browser.mjs",
    "map:inspect": "node scripts/geospatial/run.mjs inspect",
    "map:tiles": "node scripts/geospatial/run.mjs generate",
    "test:map:geo": "node scripts/geospatial/run.mjs test",
    "test:map": "node scripts/verify-map.mjs",
    "test:districts": "node scripts/verify-districts.mjs",
    "test:methodology": "node scripts/verify-methodology.mjs",
    "test:about": "node scripts/verify-about.mjs",
    "test:map-browser": "node scripts/verify-map-browser.mjs",
    "test:basemap-live": "node scripts/verify-basemap-live.mjs",
    "map:scores": "node scripts/geospatial/run.mjs scores",
    "map:scores:inspect": "node scripts/geospatial/run.mjs scores-inspect",
    "test:scores:geo": "node scripts/geospatial/run.mjs test-scores",
    "test:scores": "node scripts/verify-scores.mjs",
    "test:scores-browser": "node scripts/verify-scores-browser.mjs",
    "package:maps": "node scripts/map-distribution/package.mjs",
    "setup:maps": "node scripts/map-distribution/setup.mjs",
    "test:maps-distribution": "node scripts/map-distribution/distribution.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/libre-caslon-display": "^5.2.8",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.16.0",
    "motion": "^12.36.0",
    "proj4": "^2.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

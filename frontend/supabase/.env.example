# Server-side Edge Function configuration; set with Supabase secrets, never Vite.
SITE_URL=http://127.0.0.1:5173
## Optional Stage 1 local email capture. Blank disables access request endpoints.
# Set only in the separate test stack; never copy a service key into Vite.
ACCESS_REQUEST_MAILPIT_URL=
OFFICIAL_INVITE_REDIRECT_URL=http://127.0.0.1:5173/official/accept-invite
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.
# For local function serving only, supply local-stack values in an ignored .env.local file.

# Optional public browser configuration. Public pages/maps/scores work with these blank.
# For local official login, copy to frontend/.env.local only if that file is absent.
# Use your own running local Supabase stack's API URL and matching public key.
# The default local API URL is http://127.0.0.1:54321 (verify with local CLI status).
# localhost/127.0.0.1 points to the browser's computer, not a teammate's backend.
# Hosted Supabase authentication has not yet been finalized.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Use only a publishable or legacy anon key. Every VITE_ value is public.
# Never add service-role/secret keys, passwords or tokens to any VITE_ variable.
# Keep .env.local ignored; do not share it. Restart Vite after editing it.
# A provisioned, accepted official account is required separately; see CLONE_AND_RUN.md.

# Public map provider. No API key or account is needed for OpenFreeMap.
# Supported providers: openfreemap (default), none (explicitly disable geography).
VITE_BASEMAP_PROVIDER=openfreemap
# OpenFreeMap styles: liberty (default), positron, dark.
VITE_BASEMAP_STYLE=liberty
